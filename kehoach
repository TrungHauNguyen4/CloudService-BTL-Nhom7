      - "1433:1433"
    volumes:
      - sqlserver_data:/var/opt/mssql

  api:
    build: ./backend
    ports:
      - "8080:8080"
    environment:
      ConnectionStrings__Default: "Server=sqlserver;Database=CloudServiceDb;..."
      Jwt__Secret: "your-super-secret-key"
    depends_on:
      - sqlserver

  frontend:
    build: ./frontend
    ports:
      - "3000:3000"
    environment:
      NEXT_PUBLIC_API_URL: "http://api:8080"

volumes:
  sqlserver_data:
```

